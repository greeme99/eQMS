# ==========================================
# eQMS Environment Configuration Template
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="eQMS Backend Core"
API_V1_STR="/api/v1"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Settings
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=eqms_user
POSTGRES_PASSWORD=eqms_dev_password
POSTGRES_DB=eqms
DATABASE_URL=postgresql+asyncpg://eqms_user:eqms_dev_password@db:5432/eqms

# MinIO (S3 Compatible Storage) Settings
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKET=eqms-documents
MINIO_SECURE=false

# Keycloak (IAM) Settings
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=eqms
KEYCLOAK_CLIENT_ID=eqms-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# EU DSS (Electronic Signature Service) Settings
DSS_HOST=dss
DSS_PORT=8080
DSS_BASE_URL=http://dss:8080/services/rest

# Qdrant (Vector Database) Settings
QDRANT_HOST=qdrant
QDRANT_PORT=6333
